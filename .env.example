# 复制为 .env 后修改：cp .env.example .env
# .env 不会进入 Git（.gitignore 里排除了）。docker compose 和 jacara 都从 .env 读取配置。
# 每一项都有默认值的可以不写；标了"必填"的一定要改成你自己的随机值。
# 生成随机值：openssl rand -hex 16

# 运行模式：personal（单人，免登录）或 team（多人，需要登录）
JACARA_MODE=personal

# PostgreSQL（必填：POSTGRES_PASSWORD）
POSTGRES_USER=jacara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jacara
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Valkey（任务队列）
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379

# SeaweedFS 的 S3 接口（必填：S3_ACCESS_KEY、S3_SECRET_KEY）
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=jacara

# 本地大模型服务（jacara serve 启动的 llama-server）
MODEL_SERVER=http://127.0.0.1:8080

# 登录多久后过期（小时，team 模式）
SESSION_HOURS=12

# 上传文件大小上限（MB）
MAX_UPLOAD_MB=50
