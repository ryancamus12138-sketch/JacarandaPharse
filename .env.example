# Copy to .env and edit: cp .env.example .env
# .env is excluded from Git (.gitignore). docker compose and jacara both read their configuration from it.
# Entries with defaults may be omitted; entries marked "required" must be set to your own random values.
# While a required entry is still change-me, jacara start refuses to start and jacara doctor reports an error.
# Generate a random value: openssl rand -hex 16

# Edition: personal (single user, no login) or team (multiple users, login required)
JACARA_MODE=personal

# Runtime services. The defaults are the docker compose services; the desktop edition uses sqlite, local and huey,
# which need no separate service and keep everything in the data directory
# JACARA_DATABASE=postgres
# JACARA_STORAGE=s3
# JACARA_QUEUE=celery
# The data directory itself can only be set as an environment variable (JACARA_HOME), not in this file;
# it defaults to the project root

# API documentation at /docs: true for development; false recommended when others use the instance
JACARA_API_DOCS=true

# Directory of the built frontend. Defaults to web/dist in the project (built with cd web && npm run build)
# JACARA_WEB_DIR=/path/to/web/dist

# PostgreSQL (required: POSTGRES_PASSWORD)
POSTGRES_USER=jacara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jacara
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Valkey (task queue)
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379

# SeaweedFS S3 gateway (required: S3_ACCESS_KEY, S3_SECRET_KEY)
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=jacara

# Local LLM server (llama-server started by jacara serve / jacara start)
MODEL_SERVER=http://127.0.0.1:8080

# Model file started by jacara start. Defaults to the only .gguf file in models/
# JACARA_MODEL=models/Qwen3.5-9B-Q4_K_M.gguf

# Vision projector (optional): lets the model read the page image (handwriting, stamps, blurry photos).
# Defaults to the .gguf in models/ whose name contains mmproj; without one the model reads OCR text only
# JACARA_MMPROJ=models/mmproj-F16.gguf
# When the model sees the page image: auto only for photos and scans with unreliable OCR; always for every page (slow); off never
# JACARA_VISION=auto
# How PDFs are read: image renders each page for OCR and uses the embedded text only for cross-checking (recommended);
# text reads only the embedded text (fast; suitable only for known-clean digital PDFs)
# JACARA_PDF_READ=image
# Maximum length in pixels of the longer image side before full-page OCR (RapidOCR's default of 2000 downscales A4 at 216 DPI)
# JACARA_OCR_MAX_SIDE=4000
# Include past manual corrections for the same template as examples in the extraction prompt
# JACARA_LEARN=true
# Example selection: recent (recently and frequently corrected) or curated (model errors only, duplicates merged,
# stale examples dropped, same issuer preferred). Compare with jacara eval replay before switching
# JACARA_LEARN_MODE=recent
# Custom OCR models (also selectable under Settings → Models): detection, recognition, recognition dictionary
# JACARA_OCR_DET=models/ocr/xxx_det.onnx
# JACARA_OCR_REC=models/ocr/xxx_rec.onnx
# JACARA_OCR_DICT=models/ocr/xxx_keys.txt
# Two-stage pipeline: OCR and LLM extraction run concurrently, speeding up batch imports;
# false processes each document end to end in one process (saves a few hundred MB of memory)
# JACARA_PIPELINE=true

# Watch folder (optional): images and PDFs placed in it (including subfolders) are imported automatically;
# originals are never moved or deleted, duplicates are skipped.
# Started together by jacara start; can also run on its own with uv run jacara watch FOLDER
# JACARA_WATCH_DIR=/Users/USERNAME/Documents/Inbox
# Template for imports (id of one of my templates, as shown in the template page URL; auto selects per document);
# defaults to the template used last
# JACARA_WATCH_TEMPLATE=
# Team mode: user name recorded as the uploader of imported files
# JACARA_WATCH_USER=

# Maximum upload size (MB)
MAX_UPLOAD_MB=50

# Login session lifetime (hours, team mode)
SESSION_HOURS=12
