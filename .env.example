# 复制为 .env 后修改：cp .env.example .env
# .env 不会进入 Git（.gitignore 里排除了）。docker compose 和 jacara 都从 .env 读取配置。
# 每一项都有默认值的可以不写；标了"必填"的一定要改成你自己的随机值。
# 必填项还是 change-me 时，jacara start 会拒绝启动，jacara doctor 会报错。
# 生成随机值：openssl rand -hex 16

# 运行模式：personal（单人，免登录）或 team（多人，需要登录）
JACARA_MODE=personal

# 接口文档页 /docs：开发时 true；给别人用时建议 false
JACARA_API_DOCS=true

# 打包好的网页在哪里。不写就用项目里的 web/dist（cd web && npm run build 生成）
# JACARA_WEB_DIR=/path/to/web/dist

# PostgreSQL（必填：POSTGRES_PASSWORD）
POSTGRES_USER=jacara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jacara
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Valkey（任务队列）
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379

# SeaweedFS 的 S3 接口（必填：S3_ACCESS_KEY、S3_SECRET_KEY）
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=jacara

# 本地大模型服务（jacara serve 启动的 llama-server）
MODEL_SERVER=http://127.0.0.1:8080

# jacara start 启动哪个模型文件。不写就用 models/ 文件夹里唯一的那个 .gguf
# JACARA_MODEL=models/Qwen3.5-9B-Q4_K_M.gguf

# 视觉模型（可选，ADR 0038）：有了它模型能看原图（手写、印章、照片不清楚时）。
# 不写就用 models/ 里名字带 mmproj 的那个 .gguf；没有就只看 OCR 文字
# JACARA_MMPROJ=models/mmproj-F16.gguf
# 什么时候看原图：auto 只在照片、扫描件 OCR 不可靠时看；always 每张都看（慢）；off 不看
# JACARA_VISION=auto
# PDF 怎么读（ADR 0042）：image 每页画成图做 OCR，PDF 自带的文字只拿来核对（推荐）；
# text 只读 PDF 自带的文字（快，只适合确定干净的电子版）
# JACARA_PDF_READ=image
# 整页 OCR 前，图的长边最多多少像素（RapidOCR 默认 2000 会把 216 DPI 的 A4 先缩小）
# JACARA_OCR_MAX_SIDE=4000
# 抽取时把同一个模板以前人工改过的例子告诉模型（ADR 0045）
# JACARA_LEARN=true
# 自己训练的 OCR 模型（ADR 0046，也可以在系统信息页"换模型"里选）：检测、识别、识别用的字典
# JACARA_OCR_DET=models/ocr/xxx_det.onnx
# JACARA_OCR_REC=models/ocr/xxx_rec.onnx
# JACARA_OCR_DICT=models/ocr/xxx_keys.txt
# 后台分两个工位（ADR 0051）：OCR 认字和大模型抽取同时干活，批量导入更快；false 一个进程从头做到尾（省几百 MB 内存）
# JACARA_PIPELINE=true

# 监视文件夹（可选）：放进去的图片和 PDF 自动导入（含子文件夹），不动、不删原文件，重复的跳过。
# jacara start 会一起启动；也可以单独运行 uv run jacara watch 文件夹
# JACARA_WATCH_DIR=/Users/你的用户名/Documents/待处理单据
# 导入时用哪个模板（我的模板的 id，模板页地址栏里那串；写 auto 每张自动判断）；不写就用上一次用的
# JACARA_WATCH_TEMPLATE=
# 团队模式：导入的文件算谁传的（用户名）
# JACARA_WATCH_USER=

# 上传文件大小上限（MB）
MAX_UPLOAD_MB=50

# 登录多久后过期（小时，team 模式）
SESSION_HOURS=12
