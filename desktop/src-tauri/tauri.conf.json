{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JacarandaParse",
  "version": "1.0.0",
  "identifier": "io.github.ryancamus12138-sketch.jacarandaparse",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Ryan Camus",
    "copyright": "Copyright 2026 Ryan Camus",
    "category": "Productivity",
    "shortDescription": "Offline extraction of structured fields from receipts and invoices",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/jacara-backend/": "backend/",
      "../../web/dist/": "web/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
